{
  "canonical_domain": "https://mosque.build",
  "route_families": [
    "/mosques/[country]/[city]/[slug]",
    "/mosques/near/[slug]",
    "/architecture/[style]",
    "/components/[component]",
    "/materials/[material]",
    "/techniques/[technique]",
    "/architects/[person]",
    "/blueprints/[record]",
    "/videos/[record]",
    "/suppliers/[country]/[category]",
    "/guides/build-a-mosque/[country]",
    "/permits/[country]/[region]/[city]",
    "/cost/[country]/[city]",
    "/convert/[building-type]",
    "/funding/[topic]",
    "/waqf/[topic]",
    "/operations/[topic]",
    "/ramadan/[topic]",
    "/blog/[slug]"
  ],
  "structured_data": [
    {
      "page": "mosque profile",
      "schema": [
        "Mosque",
        "Place",
        "PostalAddress",
        "GeoCoordinates",
        "OpeningHoursSpecification",
        "BreadcrumbList"
      ]
    },
    {
      "page": "article/guide",
      "schema": [
        "Article",
        "BreadcrumbList"
      ]
    },
    {
      "page": "video",
      "schema": [
        "VideoObject",
        "BreadcrumbList"
      ]
    },
    {
      "page": "supplier product",
      "schema": [
        "Product",
        "Offer"
      ],
      "guardrail": "only when actual product/offer data qualifies"
    },
    {
      "page": "FAQ",
      "schema": [
        "FAQPage"
      ],
      "guardrail": "use only where current search-engine policy permits and content is genuinely FAQ"
    },
    {
      "page": "how-to",
      "schema": [
        "HowTo"
      ],
      "guardrail": "only for non-regulated educational procedures; never imply construction plans replace professionals"
    }
  ],
  "aeo_content_pattern": [
    "Direct 40-80 word answer at top of informational pages",
    "Then assumptions and jurisdiction/date",
    "Then calculator or structured steps",
    "Then cited sources",
    "Then related entities and alternatives",
    "Expose last-reviewed date",
    "Use precise headings matching natural questions",
    "Create concise comparison tables only where factual",
    "Maintain glossary entity pages for mosque terminology"
  ],
  "programmatic_seo_guardrails": [
    "No city page without meaningful local data",
    "No autogenerated permit page with zero verified official sources",
    "No doorway/material combinations indexed solely to create page count",
    "Canonicalize duplicate mosque aliases",
    "Noindex private project workspaces, thin search result permutations and stale drafts",
    "Generate XML sitemap shards by entity class and locale",
    "Image/video sitemaps only for rights-cleared owned/embedded assets",
    "hreflang only for genuinely translated content"
  ],
  "blog_pillars": [
    "How to build a mosque",
    "Mosque costs and budgeting",
    "Mosque architecture",
    "Mosque conversions",
    "Wudu design",
    "Prayer hall design",
    "Mosque acoustics",
    "Mosque carpet",
    "Mosque lighting",
    "Mosque accessibility",
    "Mosque sustainability",
    "Funding a mosque",
    "Waqf and endowments",
    "Mosque management",
    "Ramadan operations",
    "Iftar planning",
    "Mosque security",
    "Cleaning and maintenance",
    "Madrasa design",
    "Community center programming",
    "Historic mosque restoration",
    "Architect interviews"
  ]
}
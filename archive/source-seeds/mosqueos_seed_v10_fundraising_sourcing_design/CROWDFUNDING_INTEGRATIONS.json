      "use_cases": [
        "mosque construction",
        "renovation",
        "solar",
        "community projects",
        "Ramadan campaigns"
      ]
    },
    {
      "name": "Stripe",
      "mode": "direct payment processor",
      "features": [
        "one-time giving",
        "recurring giving",
        "Payment Links/Checkout",
        "cards/wallets",
        "webhooks",
        "refunds",
        "receipts",
        "subscription-like recurring donation schedules"
      ],
      "integration_strategy": "Native server integration through payment intents/checkout/payment links as chosen."
    },
    {
      "name": "PayPal",
      "mode": "direct/nonprofit fundraising channel",
      "features": [
        "donate button/link",
        "recurring giving where supported",
        "nonprofit account",

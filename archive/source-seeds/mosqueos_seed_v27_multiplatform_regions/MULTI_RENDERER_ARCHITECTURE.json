    },
    {
      "id": "map_maplibre_native",
      "platforms": [
        "iOS",
        "Android"
      ],
      "role": "native site/directory maps",
      "priority": "P0"
    },
    {
      "id": "map_maplibre_rn",
      "platforms": [
        "React Native iOS",
        "React Native Android"
      ],
      "role": "React Native MapLibre integration",
      "priority": "P0"
    }
  ],
  "rules": [
    "Renderer adapters consume a normalized SceneGraph, never project database rows directly.",
    "Renderer-specific materials/features must have graceful fallbacks.",
    "Any render engine may be swapped without changing design object IDs or project history.",
    "Web and mobile may use different rendering backends while presenting the same project/design version.",
    "Authoritative geometry/calculations live in shared deterministic packages, not GPU scene graphs."
  ]
}